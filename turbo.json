{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".source/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "inputs": [
        "openapi/**"
      ],
      "outputs": [
        "typescript/schema.ts"
      ]
    }
  },
  "globalPassThroughEnv": [
    "ENGINE_BASE_URL",
    "PLAYWRIGHT_BASE_URL",
    "CI",
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_DATABASE_URL",
    "DATABASE_URL",
    "SIGNUP_ALLOWLIST",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "APP_URL",
    "NEXT_PUBLIC_RULE_REVIEW_ENABLED",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_ANALYTICS_PROVIDER",
    "NEXT_PUBLIC_ANALYTICS_SRC",
    "NEXT_PUBLIC_ANALYTICS_SITE_ID",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ]
}
