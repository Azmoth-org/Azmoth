{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "inputs": [
        "openapi/**"
      ],
      "outputs": [
        "typescript/schema.ts"
      ]
    }
  },
  "globalPassThroughEnv": [
    "ENGINE_BASE_URL",
    "PLAYWRIGHT_BASE_URL",
    "CI"
  ]
}
