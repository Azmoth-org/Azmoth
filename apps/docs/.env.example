# The marketing site, linked from the navbar. Build-time: every page here is prerendered.
NEXT_PUBLIC_SITE_URL=https://azmoth.com

# This site's own origin, for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_DOCS_URL=https://docs.azmoth.com

# The product application. No longer linked from the navbar (see NEXT_PUBLIC_CAL_COM_URL below),
# kept for any other surface that resolves getAppUrl().
APP_URL=https://app.azmoth.com

# Where the navbar's "Anmelden" button sends visitors.
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/azmoth

# --- Social links ---
# Read by @workspace/ui's SocialLinks footer component. Unset means the icon is hidden, not broken.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_PRODUCTHUNT_URL=
NEXT_PUBLIC_TWITTER_URL=
