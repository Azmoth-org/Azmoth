{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Azmoth — the documentation site. Prose and the partner API reference; holds no data of its own.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "@workspace/ui": "workspace:*",
    "fumadocs-core": "^16.15.4",
