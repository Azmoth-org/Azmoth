# syntax=docker/dockerfile:1
#
# DEVELOPMENT image: `next dev` (Turbopack), meant to be run through
# infra/docker/docker-compose.dev.yml, which bind-mounts the working tree over the source copied in
# below so an edit on the host is a save, not a rebuild. For what actually ships see apps/web/Dockerfile
# — that one traces a standalone server bundle and carries neither pnpm nor node_modules; this one is
# never used to build that.
#
# The image still COPYs real source (not just manifests), so it is a working container on its own —
# `docker build -f apps/web/Dockerfile.dev -t azmoth-web:dev . && docker run -p 3000:3000
# azmoth-web:dev` boots without compose. The bind mounts are a convenience layered on top by compose,
# not a requirement for the image to run.
#
# Build context is the MONOREPO ROOT, the same rule as apps/web/Dockerfile and for the same reason:
# `@workspace/ui` and `@workspace/contracts` live outside apps/web and are consumed as source.
#
#     docker build -f apps/web/Dockerfile.dev -t azmoth-web:dev .
#
# or use infra/docker/docker-compose.dev.yml, which sets the context correctly.

# Keep this pinned exactly like apps/web/Dockerfile's `base` stage — dev and prod must build on the
# same Node, or "works in dev" stops meaning anything.
FROM node:22.14-alpine AS base
RUN corepack enable
WORKDIR /repo

# Manifests and the lockfile first, same reasoning as apps/web/Dockerfile's `deps` stage: this layer
# only invalidates when a dependency changes, not on every source edit.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

# Real source, so the image is runnable standalone (see header). Compose's bind mounts shadow all of
# this at runtime with the live working tree; what lands here only matters until that mount exists.
COPY apps/web apps/web
COPY packages/contracts packages/contracts
COPY packages/typescript-config packages/typescript-config
COPY packages/ui packages/ui

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

# COPYd on its own, after the source, so that it exists at the image path the ENTRYPOINT names even
# though compose will shadow apps/web with the working tree a moment later. Both copies are the same
# file; the mounted one is what actually runs, which is correct — the check should describe the tree
# it is checking.
COPY --chmod=755 apps/web/scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# `--hostname 0.0.0.0`, not the dev server's localhost default: inside a container that means nothing
# outside it can connect, the same fact apps/web/Dockerfile's runner stage documents for `next start`.
# `pnpm --filter web exec` rather than `pnpm --filter web dev`, so a caller can still override the
# command (e.g. a shell for debugging) without fighting the `dev` script's own argv.
#
# The entrypoint above runs before this, and before any override of it.
CMD ["pnpm", "--filter", "web", "exec", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
