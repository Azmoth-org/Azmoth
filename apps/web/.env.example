# Copy to .env and fill in. Every value below has a working local default except the two Google
# ones — with an empty .env, `pnpm dev` runs and email/password sign-in works.

# --- App & Database ---
# Accounts, sessions and organisations. Share the engine's URL so one join answers "who approved
# this"; the +asyncpg suffix is stripped for you. Default: apps/engine/test.db (SQLite, dev only).
DATABASE_URL="postgresql://..."
# Signs the session cookies. Required in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key"
# The public origin. Only needed behind a proxy that terminates TLS on another hostname.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Optional, and off unless BOTH are set. Redirect URI to register with Google:
# <origin>/api/auth/callback/google — one entry per origin, matched character for character.
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"

# --- Backend Engine ---
# The FastAPI service. Not NEXT_PUBLIC_: every call goes through /api/engine/*, which is where the
# session is checked. Default: http://localhost:8000
ENGINE_BASE_URL="http://localhost:8000"
