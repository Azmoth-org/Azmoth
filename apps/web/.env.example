# Copy to .env and fill in. Every value below has a working local default except the two Google
# ones — with an empty .env, `pnpm dev` runs and email/password sign-in works.

# --- App & Database ---
# Accounts, sessions and organisations. Share the engine's URL so one join answers "who approved
# this"; the +asyncpg suffix is stripped for you. Default: apps/engine/test.db (SQLite, dev only).
DATABASE_URL="postgresql://..."
# Signs the session cookies. Required in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key"
# The public origin. Only needed behind a proxy that terminates TLS on another hostname.
BETTER_AUTH_URL="http://localhost:3000"

# --- Who may register ---
# Comma- or space-separated. An entry starting with @ admits a whole domain; anything else is one
# exact address. Case-insensitive.
#
# UNSET MEANS NOBODY MAY REGISTER when NODE_ENV=production — deliberately, because a gate whose
# unset state is "open" is one that is open on every deployment where somebody forgot the variable.
# In development an unset list is permissive so `pnpm dev` needs no configuration to make the first
# account. See lib/auth-allowlist.ts.
SIGNUP_ALLOWLIST="anna@praxis-beispiel.de, @abrechnung-nord.de"

# --- Google OAuth ---
# Optional, and off unless BOTH are set. SIGNUP_ALLOWLIST applies to Google sign-ups too — the
# check runs on user creation, not on the password form, so both doors use the same list.
# Redirect URI to register with Google:
# <origin>/api/auth/callback/google — one entry per origin, matched character for character.
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"

# --- Backend Engine ---
# The FastAPI service. Not NEXT_PUBLIC_: every call goes through /api/engine/*, which is where the
# session is checked. Default: http://localhost:8000
ENGINE_BASE_URL="http://localhost:8000"

# --- Optional surfaces ---
# The internal GOÄ rule-verification workbench at /rules, and the two API routes that serve it.
#
# OFF unless this is set to 1 or true. That default is the point: the pilot deployment is the one
# that must never show this screen, so doing nothing hides it, and the internal instance opts in.
# A billing expert who finds /rules reads it as an invitation to correct the engine, and "the
# verdicts are not something you tune" is what the pilot is selling.
#
# NEXT_PUBLIC_ because the sidebar is a client component and the entry has to be filtered there
# too. It is NOT an access control — /rules is already behind the session and the allowlist, and
# the page and both API routes answer 404 on the server. See lib/features.ts.
NEXT_PUBLIC_RULE_REVIEW_ENABLED="1"
