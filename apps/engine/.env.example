# Every value here is OPTIONAL: the defaults are the safe ones and the engine runs with no
# configuration at all — the database defaults to a local SQLite file, so `uvicorn app.main:app`
# and `pytest` need nothing set up.
#
# There are NO secrets in this file and there must never be one. The engine needs no API key and no
# token. DATABASE_URL is the one setting that CAN carry a credential in a real deployment; it is
# documented here without one, and it belongs in the deployment's secret store, not in a committed
# file. CI fails the build if a tracked `.env` appears or if anything credential-shaped is
# committed.

# ---------------------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false

# ---------------------------------------------------------------------------------------
# Input boundary
# ---------------------------------------------------------------------------------------
# `manual` is the only supported mode: the engine takes structured clinical entities. Where they
# come from — a form, a PVS export, a model running elsewhere — is outside this boundary.
# See docs/architecture/ENGINE.md.
EXTRACTION_MODE=manual

# ---------------------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------------------
# Most exclusion rules were extracted automatically from the fee schedule's prose and are NOT
# human-verified. This decides what they are allowed to do:
#   warn   (default) they suppress nothing; the response carries a warning and counts them advisory
#   block            they are enforced exactly like verified rules
#   ignore           they are dropped entirely and counted
# `warn` is the safe default: a machine-read rule must not suppress a chargeable service until a
# human has confirmed it against the law.
UNVERIFIED_RULE_POLICY=warn

# Base Steigerungsfaktor when nothing in the record justifies more:
#   schwellenwert (default) the threshold factor (2.3 / 1.8 / 1.15). Lawful without a written
#                           justification per § 5 Abs. 2 GOÄ — what practices actually do.
#   einfachsatz             1.0. Maximally conservative, and systematically undercharges.
BASE_FACTOR_POLICY=schwellenwert

# ---------------------------------------------------------------------------------------
# Solvers
# ---------------------------------------------------------------------------------------
# Hard ceiling on one Clingo solve, in seconds. There is no value that means "unbounded".
# Observed per-case time is ~30 ms.
SOLVER_TIMEOUT_SECONDS=5

# The Soufflé binary. Not a Python package — see the README for installation.
SOUFFLE_BIN=souffle
SOUFFLE_TIMEOUT_S=60

# ---------------------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------------------
# Content-addressed: the key covers catalog identity, rule-table hash, logic hash, solver versions,
# policy and the canonical input. Editing one cell of one rule CSV misses the cache.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256

# ---------------------------------------------------------------------------------------
# Database — where proposals and the immutable audit log live
# ---------------------------------------------------------------------------------------
# A SQLAlchemy *async* URL: the driver is part of the value.
#
#   sqlite+aiosqlite:///./test.db          (default) local development and the test suite
#   sqlite+aiosqlite:///:memory:                     what pytest forces, for per-test isolation
#   postgresql+asyncpg://user:pw@host/db             production — see infra/docker/docker-compose.yml
#
# SQLite is a real database and it does survive a restart, but it is NOT a deployment target: one
# writer, one file, no replication, no encryption at rest. The engine logs a WARNING at startup
# whenever DATABASE_URL is not Postgres, and logs the resolved URL (password redacted) either way,
# so which database a container is talking to is visible in its first few lines of output.
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Log every SQL statement. Separate from DEBUG on purpose: statement logs on a service that holds
# clinical data are a leak risk, so turning them on has to be a deliberate act.
# DATABASE_ECHO=false

# Connection pool, per worker. Ignored by SQLite, which has no pool worth sizing.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Create the tables at startup with `create_all` instead of requiring `alembic upgrade head`.
# True is right for local development and for the suite. It is REFUSED when APP_ENV=production: a
# schema that appeared without a migration has no rollback and no history, so the container sets
# this to false and runs `alembic upgrade head` before uvicorn.
# DATABASE_AUTO_CREATE=true

# ---------------------------------------------------------------------------------------
# Paths — resolved from the repo root by default; set these only when logic/ and data/ are
# somewhere else (the container image sets both to /srv/logic and /srv/data).
# ---------------------------------------------------------------------------------------
# LOGIC_DIR=
# DATA_DIR=

# Set this ONLY to assert an expected snapshot: a mismatch with the shipped catalog then fails at
# startup instead of producing quietly wrong money. Empty means "trust the catalog file".
# CATALOG_VERSION=goae_official_snapshot_2026-07-25

# ---------------------------------------------------------------------------------------
# Catalog edition — temporal routing
# ---------------------------------------------------------------------------------------
# Which directory under data/catalogs/ is loaded when a caller names no edition. A fee schedule is
# not a constant, so the engine keeps one catalog per edition and an invoice can be audited against
# the edition that was in force when it was written; see data/catalogs/README.md and
# app/catalog/catalog_loader.py.
#
# NOT the same setting as CATALOG_VERSION above, which asserts the version string the chosen file
# declares. This one chooses the file.
#
# `goae_current` holds the official snapshot. The era directories beside it (goae_1996, goae_2012,
# goae_2026_current, goae_neu_draft) are small SYNTHETIC fixtures for the routing tests — pointing
# this at one of those would replace the fee schedule the engine bills with, so do not, unless you
# have replaced that directory with real data for that era.
DEFAULT_CATALOG_VERSION=goae_current

# ---------------------------------------------------------------------------------------
# Batch PADnext audit
# ---------------------------------------------------------------------------------------
# A batch is audited by a FastAPI BackgroundTask, which dies with its process. At startup, before
# the server accepts a request, any batch still PENDING or PROCESSING is therefore a run that was
# interrupted and can never continue — this marks those FAILED with "Interrupted by server restart"
# so they are visibly broken instead of appearing to still be running.
#
# Leave it on for a single-process deployment (what infra/docker/docker-compose.yml describes). Turn
# it OFF for `--workers > 1` or a rolling deploy, where a starting process would reap a batch that
# is genuinely running on a sibling; reap from a single admin step instead.
REAP_INTERRUPTED_BATCHES=true

# ---------------------------------------------------------------------------------------
# Perimeter
# ---------------------------------------------------------------------------------------
MAX_REQUEST_BYTES=33554432

# ---------------------------------------------------------------------------------------
# PADnext
# ---------------------------------------------------------------------------------------
# A delivery flagged `auftrag/@echtdaten="1"` (production data) is REFUSED unless this is enabled.
# Do not enable it without a lawful basis and the controls described in
# docs/compliance/PRIVATE_DATA_WARNING.md.
PADNEXT_ALLOW_REAL_DATA=false
