# Every value here is OPTIONAL: the defaults are the safe ones and the engine runs with no
# configuration at all. There are NO secrets in this file and the engine needs none — no API key,
# no token, no database URL.

# ---------------------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false

# ---------------------------------------------------------------------------------------
# Input boundary
# ---------------------------------------------------------------------------------------
# `manual` is the only supported mode: the engine takes structured clinical entities. Where they
# come from — a form, a PVS export, a model running elsewhere — is outside this boundary.
# See docs/architecture/ENGINE.md.
EXTRACTION_MODE=manual

# ---------------------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------------------
# Most exclusion rules were extracted automatically from the fee schedule's prose and are NOT
# human-verified. This decides what they are allowed to do:
#   warn   (default) they suppress nothing; the response carries a warning and counts them advisory
#   block            they are enforced exactly like verified rules
#   ignore           they are dropped entirely and counted
# `warn` is the safe default: a machine-read rule must not suppress a chargeable service until a
# human has confirmed it against the law.
UNVERIFIED_RULE_POLICY=warn

# Base Steigerungsfaktor when nothing in the record justifies more:
#   schwellenwert (default) the threshold factor (2.3 / 1.8 / 1.15). Lawful without a written
#                           justification per § 5 Abs. 2 GOÄ — what practices actually do.
#   einfachsatz             1.0. Maximally conservative, and systematically undercharges.
BASE_FACTOR_POLICY=schwellenwert

# ---------------------------------------------------------------------------------------
# Solvers
# ---------------------------------------------------------------------------------------
# Hard ceiling on one Clingo solve, in seconds. There is no value that means "unbounded".
# Observed per-case time is ~30 ms.
SOLVER_TIMEOUT_SECONDS=5

# The Soufflé binary. Not a Python package — see the README for installation.
SOUFFLE_BIN=souffle
SOUFFLE_TIMEOUT_S=60

# ---------------------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------------------
# Content-addressed: the key covers catalog identity, rule-table hash, logic hash, solver versions,
# policy and the canonical input. Editing one cell of one rule CSV misses the cache.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256

# ---------------------------------------------------------------------------------------
# Paths — resolved from the repo root by default; set these only when logic/ and data/ are
# somewhere else (the container image sets both to /srv/logic and /srv/data).
# ---------------------------------------------------------------------------------------
# LOGIC_DIR=
# DATA_DIR=

# Set this ONLY to assert an expected snapshot: a mismatch with the shipped catalog then fails at
# startup instead of producing quietly wrong money. Empty means "trust the catalog file".
# CATALOG_VERSION=goae_official_snapshot_2026-07-25

# ---------------------------------------------------------------------------------------
# Perimeter
# ---------------------------------------------------------------------------------------
MAX_REQUEST_BYTES=33554432

# ---------------------------------------------------------------------------------------
# PADnext
# ---------------------------------------------------------------------------------------
# A delivery flagged `auftrag/@echtdaten="1"` (production data) is REFUSED unless this is enabled.
# Do not enable it without a lawful basis and the controls described in
# docs/compliance/PRIVATE_DATA_WARNING.md.
PADNEXT_ALLOW_REAL_DATA=false
