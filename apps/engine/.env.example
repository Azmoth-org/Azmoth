# Every value here is OPTIONAL: the defaults are the safe ones and the engine runs with no
# configuration at all — the database defaults to a local SQLite file, so `uvicorn app.main:app`
# and `pytest` need nothing set up.
#
# There are NO secrets in this file and there must never be one. The engine needs no API key and no
# token. DATABASE_URL is the one setting that CAN carry a credential in a real deployment; it is
# documented here without one, and it belongs in the deployment's secret store, not in a committed
# file. CI fails the build if a tracked `.env` appears or if anything credential-shaped is
# committed.

# ---------------------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false

# ---------------------------------------------------------------------------------------
# Input boundary
# ---------------------------------------------------------------------------------------
# `manual` is the only supported mode: the engine takes structured clinical entities. Where they
# come from — a form, a PVS export, a model running elsewhere — is outside this boundary.
# See docs/architecture/ENGINE.md.
EXTRACTION_MODE=manual

# ---------------------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------------------
# Most exclusion rules were extracted automatically from the fee schedule's prose and are NOT
# human-verified. This decides what they are allowed to do:
#   warn   (default) they suppress nothing; the response carries a warning and counts them advisory
#   block            they are enforced exactly like verified rules
#   ignore           they are dropped entirely and counted
# `warn` is the safe default: a machine-read rule must not suppress a chargeable service until a
# human has confirmed it against the law.
UNVERIFIED_RULE_POLICY=warn

# Base Steigerungsfaktor when nothing in the record justifies more:
#   schwellenwert (default) the threshold factor (2.3 / 1.8 / 1.15). Lawful without a written
#                           justification per § 5 Abs. 2 GOÄ — what practices actually do.
#   einfachsatz             1.0. Maximally conservative, and systematically undercharges.
BASE_FACTOR_POLICY=schwellenwert

# ---------------------------------------------------------------------------------------
# Solvers
# ---------------------------------------------------------------------------------------
# Hard ceiling on one Clingo solve, in seconds. There is no value that means "unbounded".
# Observed per-case time is ~30 ms.
SOLVER_TIMEOUT_SECONDS=5

# The Soufflé binary. Not a Python package — see the README for installation.
SOUFFLE_BIN=souffle
SOUFFLE_TIMEOUT_S=60

# ---------------------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------------------
# Content-addressed: the key covers catalog identity, rule-table hash, logic hash, solver versions,
# policy and the canonical input. Editing one cell of one rule CSV misses the cache.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256

# ---------------------------------------------------------------------------------------
# Database — where proposals and the immutable audit log live
# ---------------------------------------------------------------------------------------
# A SQLAlchemy *async* URL: the driver is part of the value.
#
#   sqlite+aiosqlite:///./test.db          (default) local development and the test suite
#   sqlite+aiosqlite:///:memory:                     what pytest forces, for per-test isolation
#   postgresql+asyncpg://user:pw@host/db             production — see infra/docker/docker-compose.yml
#
# SQLite is a real database and it does survive a restart, but it is NOT a deployment target: one
# writer, one file, no replication, no encryption at rest. The engine logs a WARNING at startup
# whenever DATABASE_URL is not Postgres, and logs the resolved URL (password redacted) either way,
# so which database a container is talking to is visible in its first few lines of output.
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Log every SQL statement. Separate from DEBUG on purpose: statement logs on a service that holds
# clinical data are a leak risk, so turning them on has to be a deliberate act.
# DATABASE_ECHO=false

# Connection pool, per worker. Ignored by SQLite, which has no pool worth sizing.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Create the tables at startup with `create_all` instead of requiring `alembic upgrade head`.
# True is right for local development and for the suite. It is REFUSED when APP_ENV=production: a
# schema that appeared without a migration has no rollback and no history, so the container sets
# this to false and runs `alembic upgrade head` before uvicorn.
# DATABASE_AUTO_CREATE=true

# ---------------------------------------------------------------------------------------
# Paths — resolved from the repo root by default; set these only when logic/ and data/ are
# somewhere else (the container image sets both to /srv/logic and /srv/data).
# ---------------------------------------------------------------------------------------
# LOGIC_DIR=
# DATA_DIR=

# Set this ONLY to assert an expected snapshot: a mismatch with the shipped catalog then fails at
# startup instead of producing quietly wrong money. Empty means "trust the catalog file".
# CATALOG_VERSION=goae_official_snapshot_2026-07-25

# ---------------------------------------------------------------------------------------
# Catalog edition — temporal routing
# ---------------------------------------------------------------------------------------
# Which directory under data/catalogs/ is loaded when a caller names no edition. A fee schedule is
# not a constant, so the engine keeps one catalog per edition and an invoice can be audited against
# the edition that was in force when it was written; see data/catalogs/README.md and
# app/catalog/catalog_loader.py.
#
# NOT the same setting as CATALOG_VERSION above, which asserts the version string the chosen file
# declares. This one chooses the file.
#
# `goae_current` holds the official snapshot. The era directories beside it (goae_1996, goae_2012,
# goae_2026_current, goae_neu_draft) are small SYNTHETIC fixtures for the routing tests — pointing
# this at one of those would replace the fee schedule the engine bills with, so do not, unless you
# have replaced that directory with real data for that era.
DEFAULT_CATALOG_VERSION=goae_current

# ---------------------------------------------------------------------------------------
# Batch PADnext audit
# ---------------------------------------------------------------------------------------
# A batch is audited by a FastAPI BackgroundTask, which dies with its process. At startup, before
# the server accepts a request, any batch still PENDING or PROCESSING is therefore a run that was
# interrupted and can never continue — this marks those FAILED with "Interrupted by server restart"
# so they are visibly broken instead of appearing to still be running.
#
# Leave it on for a single-process deployment (what infra/docker/docker-compose.yml describes). Turn
# it OFF for `--workers > 1` or a rolling deploy, where a starting process would reap a batch that
# is genuinely running on a sibling; reap from a single admin step instead.
REAP_INTERRUPTED_BATCHES=true

# ---------------------------------------------------------------------------------------
# Transient-failure retries
# ---------------------------------------------------------------------------------------
# A database call whose CONNECTION failed is retried with exponential backoff and full jitter.
# Attempts are counted in total, so 3 is one call plus two retries, waiting a random time in
# [0,1] s and then [0,2] s. Nothing deterministic is retried — a unique violation or a missing
# table leaves on the first attempt, because the second would reach the same answer.
#
# When the attempts run out the caller gets 503 TRANSIENT_DB_FAILURE with a Retry-After header
# rather than a 500: the request was not stored, and sending it again later may well work.
# See docs/errors.md.
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_SECONDS=1.0

# ---------------------------------------------------------------------------------------
# Perimeter
# ---------------------------------------------------------------------------------------
MAX_REQUEST_BYTES=33554432

# ---------------------------------------------------------------------------------------
# PADnext
# ---------------------------------------------------------------------------------------
# A delivery flagged `auftrag/@echtdaten="1"` (production data) is REFUSED unless this is enabled.
# Do not enable it without a lawful basis and the controls described in
# docs/compliance/PRIVATE_DATA_WARNING.md.
PADNEXT_ALLOW_REAL_DATA=false

# How hard the PADnext framing check bites. A payload is validated against
# data/schemas/padnext/padx_adl_v2.12.subset.xsd before anything is read out of it:
#   strict (default) a delivery whose framing is wrong is refused with 422 and every violation
#                    named, with a line and column. Framing means: is this an ADL payload at all —
#                    root, namespace, message type, the posanzahl/anzahl counters, behandlungsart,
#                    and whether an Abrechnungsfall has positions.
#   warn             every violation becomes a finding and the audit runs anyway. The escape hatch
#                    for a real PVS export that is 99 % conforming and still worth auditing.
#   off              the schema is not consulted.
#
# What this does NOT decide is position-level leniency, which is not configurable: a goziffer with
# no @ziffer, an unreadable faktor or an unmodelled position type is always a finding and never a
# refusal. The invoices most likely to be wrong are the malformed ones — see the reasoning at the
# top of the XSD.
PADNEXT_SCHEMA_POLICY=strict

# ---------------------------------------------------------------------------------------
# Logging and error tracking
# ---------------------------------------------------------------------------------------
# `json` (default) writes one JSON object per line — timestamp, level, logger, message, plus the
# request id and, once known, the API key, the organisation and the job. That is what makes "the
# upload didn't work" answerable: the caller quotes the request id from their error response and
# every line that request produced can be found, including ones emitted inside the reader and the
# solver, which know nothing about HTTP.
#
# `text` is the older human format with the request id prefixed, for a developer watching a
# terminal. Production should stay on `json`.
LOG_FORMAT=json

# There is deliberately no SENTRY_DSN here. Every unhandled 5xx is written to the `error_log` table
# and passed to a hook that a deployment registers itself (`app.core.observability.set_error_hook`),
# so wiring up a tracker needs no dependency in this repository and no setting the engine has to
# know about. See docs/DATA_HANDLING_POLICY.md for what such a hook may and may not be given.

# ---------------------------------------------------------------------------------------
# The partner API — /api/v1/audit/*
# ---------------------------------------------------------------------------------------
# The commercial surface a PVS vendor or a billing centre integrates against. It authenticates on
# an X-API-Key header rather than on the trusted-proxy headers the web tier uses, and it takes the
# organisation from the stored key row rather than from anything in the request. There is
# deliberately no setting that turns that off: a deployment that wanted one would be publishing an
# unauthenticated audit endpoint to the internet. See docs/api/PARTNER_API.md.

# Largest single delivery POST /api/v1/audit/single accepts. 5 MiB — the bundled synthetic example
# is 3 kB, and anything materially larger is either an archive (which belongs on /audit/bulk) or a
# mistake. Enforced at the perimeter as a per-path override AND in the handler, because the
# perimeter check needs a Content-Length and a chunked upload carries none.
MAX_SINGLE_XML_BYTES=5242880

# Largest ZIP POST /api/v1/audit/bulk accepts. Above MAX_REQUEST_BYTES on purpose; the perimeter
# middleware carries a per-path override for this one route (app/core/limits.py).
MAX_BULK_ZIP_BYTES=52428800

# Zip-bomb guards. The member count bounds how many rows one upload can insert; the uncompressed
# ceiling is the one that protects the process — a 50 MB archive of zeroes expands to a terabyte.
# Both are checked twice: against the sizes the archive declares (before anything is read) and
# against the bytes that actually come out (as each member is extracted), because a declared size
# is a number the archive's author wrote.
MAX_BULK_ARCHIVE_MEMBERS=500
MAX_BULK_UNCOMPRESSED_BYTES=268435456

# How many deliveries inside one bulk job are audited at the same time. The number is about Soufflé
# rather than about Python: each audit is a subprocess, so this is what stops one 500-file upload
# from starting 500 solvers. The database writes that record the results are serialised regardless.
BULK_SOLVE_CONCURRENCY=4

# Where uploads are written. MUST be a writable volume, and it is NOT one by default in the
# container: /srv is root-owned and the engine runs as uid 10001, deliberately, so that nothing in
# a request path can write into the image. infra/docker/docker-compose.yml mounts a named volume
# and points this at it. The default below is right for a source checkout and is git-ignored.
#
# A bulk job's ZIP lives here between the 202 and the report, which is what lets an interrupted job
# resume after a restart instead of being marked FAILED.
UPLOAD_DIR=./data/uploads

# Keep a bulk upload's ZIP after its job reaches a terminal status. False is the compliance-relevant
# default: a PADnext delivery is billing data about identifiable treatment, the report derived from
# it is already in the database, and the bytes stop being needed the moment the job finishes. Turn
# it on only to debug a systematically failing integration, and turn it off again.
RETAIN_BULK_UPLOADS=false

# Rate limits, per API KEY rather than per organisation — a partner running two integrations takes
# two keys, and a runaway loop in one then cannot spend the other's budget.
#
# HONEST CAVEAT: the counters are in this process's memory. Under `--workers N` each worker counts
# its own share, so the effective limit is N times the number below; behind two containers, 2N.
# That is the same single-process assumption REAP_INTERRUPTED_BATCHES documents, and it is what
# RATE_LIMIT_ENABLED is for — a deployment with a real gateway doing this job turns it off rather
# than having two limiters disagree.
RATE_LIMIT_SINGLE_PER_MINUTE=100
RATE_LIMIT_BULK_PER_HOUR=10
RATE_LIMIT_ENABLED=true
