# Copy to .env.local for local dev, and set matching vars in Vercel project settings.
# NEVER commit real values — this file is placeholder-only.

# Postgres connection (Vercel Postgres / Neon / local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# AI intake assistant (OpenAI-compatible endpoint)
AI_API_KEY="sk-..."
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA..."

# Admin dashboard access (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# One-time /api/setup guard (db push after deploy)
SETUP_SECRET="change-me"

# Canonical public URL (used for trusted origins / links)
NEXT_PUBLIC_APP_URL="https://www.silkdev.com.tn"

# ZeptoMail (transactional email)
ZEPTOMAIL_TOKEN="paste-your-zeptomail-api-token"
ZEPTOMAIL_SENDER="noreply-<hash>@<your-bounce-domain>"
EMAIL_FROM_NAME="SILKDEV"
# While set, every email redirects here instead of the real recipient (testing)
EMAIL_TEST_OVERRIDE=""
# Where the studio gets notified of new intake briefs
BRIEFS_NOTIFY_EMAIL="contact@silkdev.com.tn"

# Konnect (Tunisia payments — CMI / e-Dinar / PayPal TN / Flous)
# KONNECT_MODE switches the gateway between live and sandbox. Set to "sandbox"
# for local dev/testing (uses api.sandbox.konnect.network + sandbox creds).
# Konnect auth: x-api-key = the Secret, receiverWalletId = the wallet ID,
# and the body `token` field is the currency code (TND|EUR|USD).
KONNECT_MODE="live"
KONNECT_API_URL="https://api.konnect.network/api/v2"
KONNECT_MERCHANT_TOKEN="paste-your-live-merchant-secret"
KONNECT_RECEIVER_WALLET_ID="paste-your-live-wallet-id"
KONNECT_SANDBOX_MERCHANT_TOKEN="paste-your-sandbox-merchant-secret"
KONNECT_SANDBOX_RECEIVER_WALLET_ID="paste-your-sandbox-wallet-id"
KONNECT_WEBHOOK_URL="https://silkdev.vercel.app/api/payments/konnect"

# Google Analytics 4 (consent-gated — loads only after the cookie banner Accept)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# OAuth providers (better-auth social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Vercel Blob (file uploads) — added by the Vercel Blob integration
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
