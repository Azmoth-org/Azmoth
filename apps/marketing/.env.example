# Copy to .env.local for local dev. Placeholder values only — never commit real ones.

# Where apps/web is served. Every "Anmelden"/"Kostenlos testen" link resolves against it.
#
# NOTE: every page on this site is statically prerendered, so this is read at BUILD
# time — a deployment sets it as a build argument, not as a container variable, and
# changing it means a rebuild. Under `next dev` it is read on every compile, so a
# restart is enough. NEXT_PUBLIC_APP_URL is accepted as an alias; APP_URL is
# preferred because it stays out of the client bundle.
APP_URL="http://localhost:3000"

# Canonical public URL of this marketing site (canonicals, sitemap, og:url).
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Google Analytics 4 — consent-gated. Unset means the cookie banner never appears
# and no analytics script is ever loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
