# Copy to .env.local for local dev. Placeholder values only — never commit real ones.

# Where apps/web is served. Every "Anmelden"/"Kostenlose Demo testen" link resolves against it.
#
# NOTE: every page on this site is statically prerendered, so this is read at BUILD
# time — a deployment sets it as a build argument, not as a container variable, and
# changing it means a rebuild. Under `next dev` it is read on every compile, so a
# restart is enough. NEXT_PUBLIC_APP_URL is accepted as an alias; APP_URL is
# preferred because it stays out of the client bundle.
APP_URL="http://localhost:3000"

# Canonical public URL of this marketing site (canonicals, sitemap, og:url).
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Reach measurement — cookieless, and off unless all three are set.
#
# Leave them empty and no script is loaded, nothing is measured and no consent banner
# appears, because nothing is stored on the visitor's device. That is the launch state.
#
# Google Analytics is deliberately not an option here: this site argues for the product
# on DSGVO grounds to a German audience, and several supervisory authorities have found
# GA use unlawful over the US transfer question. See src/lib/analytics.ts.
#
#   provider = "plausible" | "umami"
#   src      = the script URL (self-hosted or the vendor's cloud)
#   site id  = Plausible: the site domain. Umami: the website id.
#
# Plausible example:
#   NEXT_PUBLIC_ANALYTICS_PROVIDER="plausible"
#   NEXT_PUBLIC_ANALYTICS_SRC="https://plausible.io/js/script.js"
#   NEXT_PUBLIC_ANALYTICS_SITE_ID="azmoth.com"
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
NEXT_PUBLIC_ANALYTICS_SRC=""
NEXT_PUBLIC_ANALYTICS_SITE_ID=""
