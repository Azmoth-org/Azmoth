{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    // Applications emit nothing and publish nothing, so the shared base's
    // `declaration` (right for the packages, which are consumed through their
    // types) only costs diagnostics here. Same reasoning as apps/web.
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
