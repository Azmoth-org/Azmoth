# Compose environment for the Azmoth stack.
#
#     cp infra/docker/.env.example infra/docker/.env
#
# Compose reads `.env` from the directory holding the compose file, which is this one — so it is
# picked up automatically by both:
#
#     docker compose -f infra/docker/docker-compose.yml     up --build   # production
#     docker compose -f infra/docker/docker-compose.dev.yml up --build   # development
#
# Every value below has a working default in the compose files; this file exists to document what
# there is to set and to hold the values a real deployment must override. `.env` itself is
# gitignored — nothing in this repository should ever contain a production credential.


# ── Ports on the host ─────────────────────────────────────────────────────────────────────────
# Only the published side. Every container listens on its own conventional port internally.
WEB_PORT=3000
MARKETING_PORT=3001
POSTGRES_PORT=5432
ADMINER_PORT=8080


# ── The Azure deployment (infra/docker/docker-compose.azure.yml) ──────────────────────────────
# Only read when the azure override is layered on top of the production file:
#
#     docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.azure.yml up -d
#
# On the VM these are written by scripts/deploy.sh into /opt/azmoth/shared/.env and are not edited
# by hand. They are documented here because this file is where you look to find out what there is
# to set. See docs/deploy/AZURE.md.
#
# The three hostnames Caddy serves and gets certificates for. Substituted into
# infra/docker/Caddyfile when Caddy loads it; unset means Caddy refuses to start rather than
# serving an unnamed site.
APP_DOMAIN_HOST=app.azmoth.com
API_DOMAIN_HOST=api.azmoth.com
MARKETING_DOMAIN_HOST=azmoth.com

# Where Let's Encrypt sends warnings when renewal has been failing. A mailbox somebody reads — it
# is the only warning before a certificate lapses.
ACME_EMAIL=ops@azmoth.com

# Backups, for infra/scripts/backup-to-azure.sh. The storage account created by
# infra/azure/provision.sh, and the age PUBLIC key the dump is encrypted to.
#
# The matching private key must NEVER be on the VM — that is the property that makes a compromised
# host unable to read back a single backup. Keep it in a password manager.
#   age-keygen -o azmoth-backup.key      # run this on your laptop
# STORAGE_ACCOUNT=azmothbackupxxxx
# BACKUP_CONTAINER=db-backups
# AGE_RECIPIENT=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p


# ── Public addresses ──────────────────────────────────────────────────────────────────────────
# Where the product application is reachable BY A VISITOR'S BROWSER. Every "Anmelden" and
# "Kostenlos testen" button on the marketing site resolves against it.
#
# It must be a public URL. Never http://web:3000 — that name resolves only inside the compose
# network, and the browser following the link is outside it.
#
# IMPORTANT: in the production stack this is a BUILD ARGUMENT, not a container variable. Every page
# of the marketing site is statically prerendered, so this value is baked into the HTML when the
# image is built; setting it on a running container does nothing. Changing it means:
#
#     docker compose -f infra/docker/docker-compose.yml build marketing
#
# The development stack uses `next dev`, which recompiles per request, so there a restart is enough.
# NEXT_PUBLIC_APP_URL is accepted as an alias if that is the name you reach for; APP_URL wins when
# both are set, and is preferred because it never reaches the client bundle.
APP_URL=https://app.azmoth.com

# Canonical public URL of the marketing site itself — canonical links, sitemap.xml and og:url are
# built from it. Also a build argument in production, for the same reason.
MARKETING_SITE_URL=https://www.azmoth.com


# ── Database ──────────────────────────────────────────────────────────────────────────────────
# The compose defaults are azmoth/azmoth/azmoth and are DEVELOPMENT credentials. A real deployment
# supplies these from its secret store.
POSTGRES_USER=azmoth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=azmoth

# Overrides the URL the engine and Better Auth are handed. Leave unset to have it composed from the
# three values above. The `+asyncpg` suffix is SQLAlchemy's; apps/web/lib/auth-db.ts strips it, so
# one value is shared verbatim between the tiers.
# DATABASE_URL=postgresql+asyncpg://azmoth:change-me@postgres:5432/azmoth


# ── Authentication (apps/web) ─────────────────────────────────────────────────────────────────
# REQUIRED in production, and deliberately without a default anywhere. It signs every session
# cookie, so a value that changes between boots signs sessions the next container cannot verify —
# which presents as "everyone is randomly logged out". Generate with:
#
#     openssl rand -base64 32
BETTER_AUTH_SECRET=

# Only needed when a proxy terminates TLS on a different hostname than the container sees.
# BETTER_AUTH_URL=https://app.azmoth.com

# ** WHO MAY CREATE AN ACCOUNT. ** Required in production, and the only thing between /signup and
# the open internet — there is no invitation flow and no email verification behind it.
#
# Comma- or whitespace-separated. An entry starting with `@` is a DOMAIN and admits everyone at it;
# anything else is one exact address. Matching is case-insensitive and trims whitespace, so a list
# pasted out of an email works. See apps/web/lib/auth-allowlist.ts.
#
# EMPTY ADMITS NOBODY — that is the intended failure, not a bug. A gate whose unset state is "open"
# is open on every deployment where somebody forgot the variable, and it fails silently. Someone
# has to state who is allowed in. `scripts/deploy.sh --signup-allowlist` writes this value, and
# `scripts/preflight.sh` fails the deployment if it is still empty.
#
# Prefer exact addresses. `@gmail.com` here would readmit the whole internet.
SIGNUP_ALLOWLIST="pilot@praxis-beispiel.de, admin@azmoth.com"

# OPTIONAL, and off unless BOTH are set: with neither, the Google provider is not registered and no
# button is rendered. Google must be told the exact callback under "Authorised redirect URIs":
# https://app.azmoth.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Engine ────────────────────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
UNVERIFIED_RULE_POLICY=warn
BASE_FACTOR_POLICY=schwellenwert
SOLVER_TIMEOUT_SECONDS=5
CACHE_ENABLED=true

# How hard the PADnext framing check bites, before the engine reads a single position out of a
# delivery. Both compose files default it to `strict`, so setting it here is an explicit act.
#
#   strict   The application default. A delivery whose framing is wrong is refused — 422,
#            PADNEXT_SCHEMA_VIOLATION, every violation named with a line and a column. Framing
#            means: is this an ADL payload at all — root, namespace, message type, the
#            anzahl/posanzahl counters, behandlungsart, and whether an Abrechnungsfall has
#            positions.
#
#   warn     **THE PILOT SETTING — for real-world data ingestion.** Every violation becomes a
#            finding, the delivery is audited anyway, and the report carries a top-level
#            `schema_warnings` array plus `schema_policy: "warn"`, so nobody can read the result as
#            having come from a conforming file. Each affected delivery also emits one structured
#            log line (`event: padnext_schema_violation`) naming every violation's rule, line,
#            column and element path, under the request id of the upload that carried it.
#
#   off      The schema is not consulted. Not for the pilot: it produces a report indistinguishable
#            from one computed on a conforming file, which is exactly what `warn` avoids.
#
# Why `warn` for the pilot. Our XSD is a hand-written subset of PADneXt v2.12, not the official
# schema, and it has never met a real PVS export. The day-one failure is not a wrong audit — it is
# a real, slightly non-conforming export refused at the door, so the engine never gets to audit it
# at all. `warn` turns that from a 422 the partner cannot act on into a finding we can read, count,
# and correct the subset schema against.
#
# It changes NOTHING about how positions are judged: a goziffer with no @ziffer, an unreadable
# faktor, an unmodelled position type are always findings and never refusals, under every policy.
# It does not relax PADNEXT_ALLOW_REAL_DATA either, which stays false in both compose files.
#
# Set this back to `strict` when the pilot ends, or once the subset schema has been corrected
# against the deviations the pilot logged.
PADNEXT_SCHEMA_POLICY=warn


# ── Analytics (marketing) ─────────────────────────────────────────────────────────────────────
# Cookieless reach measurement, and off unless all three are set — which is the right default
# until there is something to measure. Nothing is loaded, nothing is stored on the visitor's
# device, and no consent banner appears.
#
# Google Analytics is deliberately not supported: the marketing site argues for the product on
# DSGVO grounds to a German audience, and several supervisory authorities have found GA use
# unlawful over the US transfer question. Plausible and Umami are cookieless, so § 25 TDDDG does
# not bite and no banner is required.
#
# NEXT_PUBLIC_ values, so all three are baked in at build time like APP_URL — changing one means
# rebuilding the marketing image, not restarting the container.
#
#   provider = plausible | umami
#   src      = the script URL (self-hosted or the vendor's cloud)
#   site id  = Plausible: the site domain. Umami: the website id.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
