# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# Playwright: the browser binaries live in ~/.cache/ms-playwright, but a run leaves its report and
# its per-failure traces/screenshots in the app directory. Both are reproducible from the spec.
test-results/

# The signed-in cookie Playwright's `setup` project parks for the rest of the run. A live
# credential for a live application, and machine-local by construction — see apps/web/e2e/auth.setup.ts.
apps/web/e2e/.auth/
playwright-report/
blob-report/
.playwright/

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the annotated templates. They carry no secrets and a fresh clone needs them: the
# engine's own test suite checks that every setting is documented in apps/engine/.env.example.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------------------
# apps/engine (Python)
# ---------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
apps/engine/facts/

# Hypothesis's example database: the failing inputs it found, so that a re-run replays them first.
# Machine-local and reproducible — a failure worth keeping becomes a case in logic/tests/cases/ or
# an assertion in tests/, not a committed blob.
.hypothesis/

# Licensed GOÄ datasets must never be committed: the bundled catalog is the official, public-domain
# text (§ 5 UrhG), but a licensed dataset dropped here would not be. Everything in data/licensed/
# except its README is ignored on purpose — see data/licensed/README.md.
data/licensed/*
!data/licensed/README.md

# Raw downloads are large and reproducible from data/raw/manifest.json; the XML the committed
# catalog was actually built from is the one exception and is tracked deliberately.
data/raw/*.zip

# Local SQLite databases. DATABASE_URL defaults to `sqlite+aiosqlite:///./test.db`, so a plain
# `uvicorn app.main:app` in apps/engine leaves one behind — it holds proposals and must never be
# committed or baked into an image.
**/test.db
**/*.sqlite
**/*.sqlite3
apps/engine/*.db
*.db
*.sqlite
*.sqlite3

# Uploads the engine writes at runtime: a bulk job's ZIP lives here between the 202 and the report.
# Under data/ because UPLOAD_DIR defaults beside the catalogs in a source checkout — but unlike
# everything else in that directory this is neither versioned nor reproducible, it is somebody's
# billing data. A deployment points UPLOAD_DIR at a mounted volume instead; see
# apps/engine/.env.example.
data/uploads/

# Database dumps. `make backup-db` writes here. They are a full copy of everything the deployment
# holds — approvals, audit events, API key hashes — so a `git add -A` that swept one into a commit
# would put a practice's records in a repository, permanently and irrevocably.
backups/
