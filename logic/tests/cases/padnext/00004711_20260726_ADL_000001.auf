  </system>

  <verschluesselung verfahren="0"/>
  <empfangsquittung>0</empfangsquittung>

  <datei erstellungsdatum="2026-07-26T09:30:00Z" id="synth-0001">
    <dokumententyp>PADneXt</dokumententyp>
