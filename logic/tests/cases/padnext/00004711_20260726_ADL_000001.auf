         xsi:schemaLocation="http://padinfo.de/ns/pad http://www.padinfo.de/ns/pad/padx_auf_v2.12.xsd">

  <empfaenger>
    <logisch kundennr="4711">Musterpraxis Dr. Beispiel (synthetisch)</logisch>
    <physikalisch rzid="000">Beispiel-Rechenzentrum (synthetisch)</physikalisch>
  </empfaenger>

  <absender>
    <logisch kundennr="4711">Musterpraxis Dr. Beispiel (synthetisch)</logisch>
    <physikalisch rzid="000">Beispiel-Rechenzentrum (synthetisch)</physikalisch>
