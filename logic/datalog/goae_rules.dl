// ============================================================================================
// GOÄ RULES ENGINE — Soufflé Datalog
// ============================================================================================
// Decides what is CERTAIN about a proposed set of GOÄ positions, and emits the premises for
// every conclusion. Everything here is monotone, terminating and stratified.
//
// STRATIFICATION — why the layers exist and why the order matters
// Suppression in the GOÄ is layered, and a position that has already lost must not itself
// suppress a third one:
//
//   proposed -> surviving_specific -> surviving_zielleistung -> surviving_exclusion -> billable
//                  specificity          § 4 Abs. 2a              Leistungslegenden
//
// Each layer negates only the layer above it, so the program is stratified and has a unique
// minimal model. A single self-referential `blocked` relation — the obvious first attempt — is
// NOT stratifiable and would either be rejected outright or quietly produce a wrong model.
//
// WHAT THIS PROGRAM DELIBERATELY REFUSES TO DECIDE
// Many GOÄ exclusions are mutual: Nr. 5, 6, 7 and 8 exclude one another, and so do Nr. 422-424
// and Nr. 650-653. Under negation-as-failure every member of such a cluster would block every
// other and the whole cluster would vanish — silently destroying a legitimate charge. Those
// clusters are detected here and exported as `conflict` for the ASP layer to arbitrate under an
// explicit objective. Datalog concludes what follows; it never guesses.
//
// Rule identifiers travel with every conclusion so the proof tree can be joined back to the
// exact CSV row and legal quote that produced it.
// ============================================================================================

// --- INPUT (generated by app/rules/goae_facts.py from catalog + rules + bridge) -------------

.decl ziffer(z: symbol, punkte: number, category: symbol, active: number)
.input ziffer

// exclusion(RuleId, A, B, Mutual): if A is charged, B is not chargeable. Mutual=1 marks a pair
// the law states in both directions.
.decl exclusion(rule_id: symbol, a: symbol, b: symbol, mutual: number)
.input exclusion

// zielleistung(RuleId, Parent, Child): Child is a methodically necessary component of Parent.
.decl zielleistung(rule_id: symbol, parent: symbol, child: symbol)
.input zielleistung

// specificity(RuleId, Specific, General): for one and the same act, Specific displaces General.
.decl specificity(rule_id: symbol, specific: symbol, general: symbol)
.input specificity

.decl act(act_id: symbol, source: symbol, entity_type: symbol)
.input act

// candidate(Act, Ziffer, Priority, Confidence*100)
.decl candidate(act_id: symbol, z: symbol, priority: number, confidence: number)
.input candidate

// Steigerungsfaktor band per category, scaled by 100 (§ 5 GOÄ).
.decl sf_band(category: symbol, threshold: number, max_factor: number)
.input sf_band

// Per-Ziffer band override — § 5 Abs. 4 names Nummer 437 individually.
.decl sf_override(z: symbol, threshold: number, max_factor: number)
.input sf_override

// factor_cap(RuleId, Ziffer, Max*100) — "nur mit dem einfachen Gebührensatz berechnungsfähig".
.decl factor_cap(rule_id: symbol, z: symbol, max_factor: number)
.input factor_cap

// The factor actually chosen, scaled by 100. Empty on the first pass; filled on the
// verification pass so the rules engine can rule on the solver's choice independently.
.decl proposed_factor(z: symbol, factor: number)
.input proposed_factor

.decl patient_setting(setting: symbol)
.input patient_setting

// minderung(Setting, Rate*100) — § 6a GOÄ.
.decl minderung_rate(setting: symbol, rate: number)
.input minderung_rate

// Ziffern exempt from § 6a Minderung (§ 6a Abs. 1 Satz 3).
.decl minderung_exempt(z: symbol)
.input minderung_exempt

// ============================================================================================
// LAYER 0 — what was proposed, and whether it is usable at all
// ============================================================================================

.decl proposed(z: symbol)
proposed(Z) :- candidate(_, Z, _, _).
.output proposed

.decl unknown_ziffer(z: symbol)
unknown_ziffer(Z) :- proposed(Z), !ziffer(Z, _, _, _).
.output unknown_ziffer

.decl inactive_ziffer(z: symbol)
inactive_ziffer(Z) :- proposed(Z), ziffer(Z, _, _, 0).
.output inactive_ziffer

.decl usable(z: symbol)
usable(Z) :- proposed(Z), ziffer(Z, _, _, 1).

// ============================================================================================
// LAYER 1 — specificity: one clinical act yields one position
// ============================================================================================
// A knee puncture matches Nr. 300 (a joint) and Nr. 301 (a knee joint). Both are proposed by
// the bridge on purpose so that the choice is made by a rule with a legal basis, visibly, here.

.decl blocked_less_specific(z: symbol, winner: symbol, rule_id: symbol)
blocked_less_specific(General, Specific, RuleId) :-
    candidate(A, General, _, _),
    candidate(A, Specific, _, _),
    specificity(RuleId, Specific, General),
    usable(General),
    usable(Specific).
.output blocked_less_specific

.decl surviving_specific(z: symbol)
surviving_specific(Z) :- usable(Z), !blocked_less_specific(Z, _, _).

// ============================================================================================
// LAYER 2 — Zielleistungsprinzip (§ 4 Abs. 2a GOÄ)
// ============================================================================================
// A component is not chargeable next to its target service. Resolved HERE rather than in the
// optimiser on purpose: components are frequently worth more in sum than the target service, so
// an optimiser told to maximise revenue would prefer to split them, which is precisely the
// upcoding pattern that gets invoices rejected. It is a hard rule, not a trade-off.

.decl blocked_zielleistung(z: symbol, parent: symbol, rule_id: symbol)
blocked_zielleistung(Child, Parent, RuleId) :-
    surviving_specific(Child),
    surviving_specific(Parent),
    zielleistung(RuleId, Parent, Child),
    Parent != Child.
.output blocked_zielleistung

.decl surviving_zielleistung(z: symbol)
surviving_zielleistung(Z) :- surviving_specific(Z), !blocked_zielleistung(Z, _, _).

// ============================================================================================
// LAYER 3 — exclusions where the direction is unambiguous
// ============================================================================================
// Only ONE-WAY exclusions are decided here: A excludes B while B does not exclude A, so B
// definitely loses and no choice is involved.

.decl blocked_exclusion(z: symbol, blocked_by: symbol, rule_id: symbol)
blocked_exclusion(B, A, RuleId) :-
    surviving_zielleistung(A),
    surviving_zielleistung(B),
    exclusion(RuleId, A, B, 0),
    !exclusion(_, B, A, _),
    A != B.
.output blocked_exclusion

.decl surviving_exclusion(z: symbol)
surviving_exclusion(Z) :- surviving_zielleistung(Z), !blocked_exclusion(Z, _, _).

// A blocker that is itself blocked must not suppress a third position. Rather than assume the
// rule set never contains such a chain, the engine reports it, so the need for another stratum
// surfaces as a warning instead of as a wrong invoice.
.decl exclusion_chain_warning(z: symbol, via: symbol, root: symbol)
exclusion_chain_warning(C, B, A) :-
    surviving_zielleistung(A), surviving_zielleistung(B), surviving_zielleistung(C),
    exclusion(_, A, B, 0), !exclusion(_, B, A, _),
    exclusion(_, B, C, 0), !exclusion(_, C, B, _).
.output exclusion_chain_warning

// ============================================================================================
// LAYER 4 — mutual clusters: handed to the ASP solver
// ============================================================================================

.decl conflict(a: symbol, b: symbol, rule_id: symbol)
conflict(A, B, RuleId) :-
    surviving_exclusion(A),
    surviving_exclusion(B),
    exclusion(RuleId, A, B, 1),
    exclusion(_, B, A, 1),
    ord(A) < ord(B).
.output conflict

.decl in_conflict(z: symbol)
in_conflict(Z) :- conflict(Z, _, _).
in_conflict(Z) :- conflict(_, Z, _).

// Certainly chargeable: survived every hard rule and competes with nothing.
.decl billable(z: symbol)
billable(Z) :- surviving_exclusion(Z), !in_conflict(Z).
.output billable

// Chargeable in principle, but a choice is required.
.decl needs_arbitration(z: symbol)
needs_arbitration(Z) :- surviving_exclusion(Z), in_conflict(Z).
.output needs_arbitration

.decl chargeable(z: symbol)
chargeable(Z) :- billable(Z).
chargeable(Z) :- needs_arbitration(Z).

// ============================================================================================
// LAYER 5 — Steigerungsfaktor validation (§ 5, § 12 Abs. 3 GOÄ)
// ============================================================================================
// Values are scaled by 100 because Datalog numbers are integers: 230 means factor 2.3.

.decl factor_band(z: symbol, threshold: number, max_factor: number)
factor_band(Z, T, M) :- chargeable(Z), sf_override(Z, T, M).
factor_band(Z, T, M) :- chargeable(Z), ziffer(Z, _, K, _), sf_band(K, T, M), !sf_override(Z, _, _).
.output factor_band

// Above the Schwellenwert a written justification is mandatory.
.decl needs_justification(z: symbol, factor: number, threshold: number)
needs_justification(Z, F, T) :-
    chargeable(Z), factor_band(Z, T, _), proposed_factor(Z, F), F > T.
.output needs_justification

// Above the Höchstsatz the factor is unlawful absent a § 2 agreement.
.decl invalid_factor(z: symbol, factor: number, max_factor: number)
invalid_factor(Z, F, M) :-
    chargeable(Z), factor_band(Z, _, M), proposed_factor(Z, F), F > M.
.output invalid_factor

// A per-Ziffer cap from the Leistungslegende overrides the band.
.decl invalid_factor_cap(z: symbol, factor: number, cap: number, rule_id: symbol)
invalid_factor_cap(Z, F, Cap, RuleId) :-
    chargeable(Z), factor_cap(RuleId, Z, Cap), proposed_factor(Z, F), F > Cap.
.output invalid_factor_cap

// ============================================================================================
// LAYER 6 — § 6a GOÄ Minderung
// ============================================================================================

.decl mindered(z: symbol, rate: number)
mindered(Z, R) :-
    chargeable(Z), patient_setting(S), minderung_rate(S, R), R > 0, !minderung_exempt(Z).
.output mindered

// ============================================================================================
// PROOF TREE
// ============================================================================================
// Every conclusion, positive and negative, gets a justification row carrying the rule id that
// produced it. This is the machine-checkable answer to "why is this on my bill?".

.decl proof(z: symbol, rule: symbol, detail: symbol, rule_id: symbol)
.output proof

proof(Z, "catalog_match", "present_and_active_in_loaded_catalog", "") :-
    chargeable(Z).

proof(Z, "derived_from_act", T, "") :-
    chargeable(Z), candidate(A, Z, _, _), act(A, _, T).

proof(Z, "most_specific_candidate", "no_more_specific_position_for_the_same_act", "") :-
    chargeable(Z), !blocked_less_specific(Z, _, _).

proof(Z, "not_zielleistung_component", "not_a_component_of_another_charged_service", "") :-
    chargeable(Z), !blocked_zielleistung(Z, _, _).

proof(Z, "not_excluded", "no_one_way_exclusion_violated", "") :-
    chargeable(Z), !blocked_exclusion(Z, _, _).

proof(Z, "no_unresolved_conflict", "no_mutually_exclusive_competitor", "") :-
    billable(Z), !in_conflict(Z).

proof(Z, "blocked_less_specific", W, RuleId) :- blocked_less_specific(Z, W, RuleId).
proof(Z, "blocked_zielleistung", P, RuleId) :- blocked_zielleistung(Z, P, RuleId).
proof(Z, "blocked_exclusion", A, RuleId) :- blocked_exclusion(Z, A, RuleId).

proof(Z, "conflict_pending_arbitration", B, RuleId) :- conflict(Z, B, RuleId).
proof(Z, "conflict_pending_arbitration", A, RuleId) :- conflict(A, Z, RuleId).

proof(Z, "unknown_ziffer", "not_present_in_loaded_catalog", "") :- unknown_ziffer(Z).
proof(Z, "inactive_ziffer", "present_but_not_active_in_catalog", "") :- inactive_ziffer(Z).

proof(Z, "justification_required", "factor_above_schwellenwert_needs_written_reason", "") :-
    needs_justification(Z, _, _).
proof(Z, "factor_above_hoechstsatz", "unlawful_without_agreement_under_para_2_goae", "") :-
    invalid_factor(Z, _, _).
proof(Z, "factor_above_cap", "leistungslegende_caps_this_position", RuleId) :-
    invalid_factor_cap(Z, _, _, RuleId).

proof(Z, "minderung_applicable", S, "") :-
    chargeable(Z), patient_setting(S), minderung_rate(S, R), R > 0, !minderung_exempt(Z).
proof(Z, "minderung_exempt", "para_6a_abs_1_satz_3_goae", "") :-
    chargeable(Z), minderung_exempt(Z).
