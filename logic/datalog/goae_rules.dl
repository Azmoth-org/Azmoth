// ============================================================================================
// GOÄ RULES ENGINE — Soufflé Datalog
// ============================================================================================
// Decides what is CERTAIN about a proposed set of GOÄ positions, and emits the premises for
// every conclusion. Everything here is monotone, terminating and stratified.
//
// STRATIFICATION — why the layers exist and why the order matters
// Suppression in the GOÄ is layered, and a position that has already lost must not itself
// suppress a third one:
//
//   proposed -> surviving_specific -> surviving_zielleistung -> surviving_exclusion -> billable
//                  specificity          § 4 Abs. 2a              Leistungslegenden
//
// Each layer negates only the layer above it, so the program is stratified and has a unique
// minimal model. A single self-referential `blocked` relation — the obvious first attempt — is
// NOT stratifiable and would either be rejected outright or quietly produce a wrong model.
//
// WHAT THIS PROGRAM DELIBERATELY REFUSES TO DECIDE
// Many GOÄ exclusions are mutual: Nr. 5, 6, 7 and 8 exclude one another, and so do Nr. 422-424
// and Nr. 650-653. Under negation-as-failure every member of such a cluster would block every
// other and the whole cluster would vanish — silently destroying a legitimate charge. Those
// clusters are detected here and exported as `conflict` for the ASP layer to arbitrate under an
// explicit objective. Datalog concludes what follows; it never guesses.
//
// Rule identifiers travel with every conclusion so the proof tree can be joined back to the
// exact CSV row and legal quote that produced it.
// ============================================================================================

// --- INPUT (generated by app/rules/goae_facts.py from catalog + rules + bridge) -------------

.decl ziffer(z: symbol, punkte: number, category: symbol, active: number)
.input ziffer

// exclusion(RuleId, A, B, Mutual): if A is charged, B is not chargeable. Mutual=1 marks a pair
// the law states in both directions.
.decl exclusion(rule_id: symbol, a: symbol, b: symbol, mutual: number)
.input exclusion

// zielleistung(RuleId, Parent, Child): Child is a methodically necessary component of Parent.
.decl zielleistung(rule_id: symbol, parent: symbol, child: symbol)
.input zielleistung

// specificity(RuleId, Specific, General): for one and the same act, Specific displaces General.
.decl specificity(rule_id: symbol, specific: symbol, general: symbol)
.input specificity

.decl act(act_id: symbol, source: symbol, entity_type: symbol)
.input act

// candidate(Act, Ziffer, Priority, Confidence*100)
.decl candidate(act_id: symbol, z: symbol, priority: number, confidence: number)
.input candidate

// Steigerungsfaktor band per category, scaled by 100 (§ 5 GOÄ).
.decl sf_band(category: symbol, threshold: number, max_factor: number)
.input sf_band

// Per-Ziffer band override — § 5 Abs. 4 names Nummer 437 individually.
.decl sf_override(z: symbol, threshold: number, max_factor: number)
.input sf_override

// factor_cap(RuleId, Ziffer, Max*100) — "nur mit dem einfachen Gebührensatz berechnungsfähig".
.decl factor_cap(rule_id: symbol, z: symbol, max_factor: number)
.input factor_cap

// The factor actually chosen, scaled by 100. Empty on the first pass; filled on the
// verification pass so the rules engine can rule on the solver's choice independently.
.decl proposed_factor(z: symbol, factor: number)
.input proposed_factor

.decl patient_setting(setting: symbol)
.input patient_setting

// minderung(Setting, Rate*100) — § 6a GOÄ.
.decl minderung_rate(setting: symbol, rate: number)
.input minderung_rate

// Ziffern exempt from § 6a Minderung (§ 6a Abs. 1 Satz 3).
.decl minderung_exempt(z: symbol)
.input minderung_exempt

// datum(Z, Date): Z was actually rendered on Date (YYYY-MM-DD). A Ziffer can carry more than one
// row when it was claimed more than once at different dates — see LAYER 3 below, which treats
// any shared date as "alongside". Absent entirely for a Ziffer whose date is not tracked by the
// caller, which is the common case outside PADnext audit and must not change what LAYER 3 decides.
.decl datum(z: symbol, date: symbol)
.input datum

// --- coverage-sprint constraint families — see docs/content/adr-002-complex-constraints.md ------
// Mengenbegrenzung, Zeitbeziehung, Geschlecht, Alter. Every one of these relations is empty for a
// caller that supplies nothing for it, in which case the layer it feeds concludes nothing — the
// same "absent means untracked, not permitted" reading `datum` already established above.

// quantity_limit(RuleId, Ziffer, MaxCount): Z may be billed at most MaxCount times per
// Behandlungsfall (§ 21 GOÄ — the calendar quarter). Scaled by nothing; MaxCount is a plain count.
.decl quantity_limit(rule_id: symbol, z: symbol, max_count: number)
.input quantity_limit

// history_count(Ziffer, Count): how many times Z was already billed for THIS patient earlier in
// the current Behandlungsfall, before this invoice. Computed in Postgres
// (`app.services.patient_history.quarter_counts`) and handed in exactly like `proposed_factor` —
// a caller that never tracks patient history (every caller except the wired-up PADnext path)
// supplies none, and the layer below concludes nothing, exactly as if no limit existed.
.decl history_count(z: symbol, occurrences: number)
.input history_count

// time_relation(RuleId, A, B, Kind): a Zeitbeziehung between two Ziffern. Kind is
// "same_day_excludes" (B is not chargeable alongside A on the same claimed date — decidable from
// `datum`) or "min_hours_apart" (A and B must be a minimum number of hours apart — NOT decidable
// from a date alone, and therefore only ever advisory; see LAYER 8).
.decl time_relation(rule_id: symbol, a: symbol, b: symbol, kind: symbol)
.input time_relation

// gender_restriction(RuleId, Ziffer, AllowedGender): Z's Leistungslegende is scoped to one sex —
// "m", "w" or "d", matching `app.schemas.case.Patient.sex` exactly.
.decl gender_restriction(rule_id: symbol, z: symbol, allowed_gender: symbol)
.input gender_restriction

// patient_gender(Gender): 0 or 1 rows — the claimed encounter's patient, when known.
.decl patient_gender(gender: symbol)
.input patient_gender

// age_restriction(RuleId, Ziffer, MinAge, MaxAge): Z's Leistungslegende is scoped to an age band,
// inclusive on both ends. An unbounded side is written 0 (MinAge) or 999 (MaxAge) by
// `app/solvers/souffle_facts.py` — Datalog has no null, and both sentinels sit outside any real
// human age, which `Patient.age`'s own `ge=0, le=130` validator already enforces upstream.
.decl age_restriction(rule_id: symbol, z: symbol, min_age: number, max_age: number)
.input age_restriction

// patient_age(Age): 0 or 1 rows — whole years as of the service date. **Never** derived from a
// date of birth inside this engine; see the ADR for why a birth date is not something a PADnext
// ingestion path may compute this from.
.decl patient_age(age: number)
.input patient_age

// ============================================================================================
// LAYER 0 — what was proposed, and whether it is usable at all
// ============================================================================================

.decl proposed(z: symbol)
proposed(Z) :- candidate(_, Z, _, _).
.output proposed

.decl unknown_ziffer(z: symbol)
unknown_ziffer(Z) :- proposed(Z), !ziffer(Z, _, _, _).
.output unknown_ziffer

.decl inactive_ziffer(z: symbol)
inactive_ziffer(Z) :- proposed(Z), ziffer(Z, _, _, 0).
.output inactive_ziffer

.decl usable(z: symbol)
usable(Z) :- proposed(Z), ziffer(Z, _, _, 1).

// ============================================================================================
// LAYER 1 — specificity: one clinical act yields one position
// ============================================================================================
// A knee puncture matches Nr. 300 (a joint) and Nr. 301 (a knee joint). Both are proposed by
// the bridge on purpose so that the choice is made by a rule with a legal basis, visibly, here.

.decl blocked_less_specific(z: symbol, winner: symbol, rule_id: symbol)
blocked_less_specific(General, Specific, RuleId) :-
    candidate(A, General, _, _),
    candidate(A, Specific, _, _),
    specificity(RuleId, Specific, General),
    usable(General),
    usable(Specific).
.output blocked_less_specific

.decl surviving_specific(z: symbol)
surviving_specific(Z) :- usable(Z), !blocked_less_specific(Z, _, _).

// ============================================================================================
// LAYER 2 — Zielleistungsprinzip (§ 4 Abs. 2a GOÄ)
// ============================================================================================
// A component is not chargeable next to its target service. Resolved HERE rather than in the
// optimiser on purpose: components are frequently worth more in sum than the target service, so
// an optimiser told to maximise revenue would prefer to split them, which is precisely the
// upcoding pattern that gets invoices rejected. It is a hard rule, not a trade-off.

.decl blocked_zielleistung(z: symbol, parent: symbol, rule_id: symbol)
blocked_zielleistung(Child, Parent, RuleId) :-
    surviving_specific(Child),
    surviving_specific(Parent),
    zielleistung(RuleId, Parent, Child),
    Parent != Child.
.output blocked_zielleistung

.decl surviving_zielleistung(z: symbol)
surviving_zielleistung(Z) :- surviving_specific(Z), !blocked_zielleistung(Z, _, _).

// ============================================================================================
// LAYER 3 — exclusions where the direction is unambiguous
// ============================================================================================
// Only ONE-WAY exclusions are decided here: A excludes B while B does not exclude A, so B
// definitely loses and no choice is involved.
//
// "Neben" (alongside) in a GOÄ exclusion is a clinical term — the two services rendered at the
// same encounter — not a bookkeeping one, so the same-Ziffer match below is additionally split on
// `datum`. `known_date`/`same_service_date` are plain, non-recursive joins over the base `datum`
// facts, so negating them in `cross_service_date` (and that in turn in `blocked_exclusion`) stays
// a single stratum below LAYER 3 — no cycle through `blocked_exclusion` itself.

.decl known_date(z: symbol)
known_date(Z) :- datum(Z, _).

// Any date the two Ziffern share counts as "alongside" — the conservative reading for a Ziffer
// claimed more than once at different dates (see the comment on `.decl datum` above).
.decl same_service_date(a: symbol, b: symbol)
same_service_date(A, B) :- datum(A, D), datum(B, D).

// `True` only when BOTH sides have a known date and none of them coincide. One side's date being
// unknown is not evidence of anything, so it must not read as "different dates" — that would
// turn a caller that never tracks dates at all into one where every exclusion looks cross-date.
.decl cross_service_date(a: symbol, b: symbol)
cross_service_date(A, B) :- known_date(A), known_date(B), !same_service_date(A, B).

.decl blocked_exclusion(z: symbol, blocked_by: symbol, rule_id: symbol)
blocked_exclusion(B, A, RuleId) :-
    surviving_zielleistung(A),
    surviving_zielleistung(B),
    exclusion(RuleId, A, B, 0),
    !exclusion(_, B, A, _),
    A != B,
    !cross_service_date(A, B).
.output blocked_exclusion

// The same match, but the two Ziffern are known to have been rendered on different dates. Kept
// out of `blocked_exclusion` — and out of `billable` below, via `surviving_exclusion` — because a
// human still has to look at it: the invoice alone does not say the exclusion definitely does NOT
// apply, only that this engine cannot say it does. `app/padnext/audit.py` reads this into the
// advisory (`unconfirmed`) bucket rather than `confirmed_wrong`.
.decl blocked_exclusion_cross_date(z: symbol, blocked_by: symbol, rule_id: symbol)
blocked_exclusion_cross_date(B, A, RuleId) :-
    surviving_zielleistung(A),
    surviving_zielleistung(B),
    exclusion(RuleId, A, B, 0),
    !exclusion(_, B, A, _),
    A != B,
    cross_service_date(A, B).
.output blocked_exclusion_cross_date

.decl surviving_exclusion(z: symbol)
surviving_exclusion(Z) :-
    surviving_zielleistung(Z), !blocked_exclusion(Z, _, _), !blocked_exclusion_cross_date(Z, _, _).

// A blocker that is itself blocked must not suppress a third position. Rather than assume the
// rule set never contains such a chain, the engine reports it, so the need for another stratum
// surfaces as a warning instead of as a wrong invoice.
.decl exclusion_chain_warning(z: symbol, via: symbol, root: symbol)
exclusion_chain_warning(C, B, A) :-
    surviving_zielleistung(A), surviving_zielleistung(B), surviving_zielleistung(C),
    exclusion(_, A, B, 0), !exclusion(_, B, A, _),
    exclusion(_, B, C, 0), !exclusion(_, C, B, _).
.output exclusion_chain_warning

// ============================================================================================
// LAYER 3.5 — Mengenbegrenzung (§ 21 GOÄ Behandlungsfall — a quantity cap per patient per quarter)
// ============================================================================================
// `history_count` is computed OUTSIDE this program, in Postgres — see
// `app/services/patient_history.py` — because it is a fact about a patient across invoices, and
// this program only ever sees one invoice. Empty for every caller that does not track patient
// history, in which case this layer concludes nothing and every Ziffer passes through unchanged.

.decl blocked_quantity(z: symbol, rule_id: symbol, occurrences: number, max_count: number)
blocked_quantity(Z, RuleId, Count, Max) :-
    surviving_exclusion(Z), quantity_limit(RuleId, Z, Max), history_count(Z, Count), Count >= Max.
.output blocked_quantity

.decl surviving_quantity(z: symbol)
surviving_quantity(Z) :- surviving_exclusion(Z), !blocked_quantity(Z, _, _, _).

// ============================================================================================
// LAYER 3.6 — Zeitbeziehung (time relations between two Ziffern)
// ============================================================================================
// Only the "same_day_excludes" kind is decidable and enforced — a claimed `<datum>` is a calendar
// date, and two dates either match or they do not. "min_hours_apart" is NEVER enforced: it needs a
// timestamp this engine does not have and must not guess at, so it is surfaced below as an
// advisory finding on a same-day match and never removes a position from `billable`. See
// `docs/content/adr-002-complex-constraints.md` §Zeitbeziehung.

.decl blocked_time_relation(z: symbol, blocked_by: symbol, rule_id: symbol)
blocked_time_relation(B, A, RuleId) :-
    surviving_quantity(A),
    surviving_quantity(B),
    time_relation(RuleId, A, B, "same_day_excludes"),
    same_service_date(A, B),
    A != B.
.output blocked_time_relation

.decl surviving_time_relation(z: symbol)
surviving_time_relation(Z) :- surviving_quantity(Z), !blocked_time_relation(Z, _, _).

// Advisory only — never negated into `surviving_time_relation`. A same-day match under a
// "min_hours_apart" relation is exactly the case this engine cannot resolve either way.
.decl time_relation_advisory(z: symbol, other: symbol, rule_id: symbol)
time_relation_advisory(A, B, RuleId) :-
    surviving_time_relation(A),
    surviving_time_relation(B),
    time_relation(RuleId, A, B, "min_hours_apart"),
    same_service_date(A, B),
    A != B.
.output time_relation_advisory

// ============================================================================================
// LAYER 3.7 — Geschlecht (a Leistungslegende scoped to one sex)
// ============================================================================================
// `patient_gender` is 0 or 1 rows. Absent means unknown, and unknown must not read as a mismatch
// — the same "silence is not evidence" reading `cross_service_date` gives an unknown `datum`.

.decl blocked_gender(z: symbol, rule_id: symbol, patient_gender: symbol, allowed_gender: symbol)
blocked_gender(Z, RuleId, G, Allowed) :-
    surviving_time_relation(Z),
    gender_restriction(RuleId, Z, Allowed),
    patient_gender(G),
    G != Allowed.
.output blocked_gender

.decl surviving_gender(z: symbol)
surviving_gender(Z) :- surviving_time_relation(Z), !blocked_gender(Z, _, _, _).

// ============================================================================================
// LAYER 3.8 — Alter (a Leistungslegende scoped to an age band, in whole years)
// ============================================================================================
// `patient_age` is 0 or 1 rows, in whole years as of the service date — never derived from a date
// of birth inside this engine. Absent means unknown, read the same way as an absent
// `patient_gender`: not evidence of a violation.

.decl blocked_age(z: symbol, rule_id: symbol, age: number, min_age: number, max_age: number)
blocked_age(Z, RuleId, Age, MinAge, MaxAge) :-
    surviving_gender(Z), age_restriction(RuleId, Z, MinAge, MaxAge), patient_age(Age), Age < MinAge.
blocked_age(Z, RuleId, Age, MinAge, MaxAge) :-
    surviving_gender(Z), age_restriction(RuleId, Z, MinAge, MaxAge), patient_age(Age), Age > MaxAge.
.output blocked_age

.decl surviving_age(z: symbol)
surviving_age(Z) :- surviving_gender(Z), !blocked_age(Z, _, _, _, _).

// ============================================================================================
// LAYER 4 — mutual clusters: handed to the ASP solver
// ============================================================================================

.decl conflict(a: symbol, b: symbol, rule_id: symbol)
conflict(A, B, RuleId) :-
    surviving_age(A),
    surviving_age(B),
    exclusion(RuleId, A, B, 1),
    exclusion(_, B, A, 1),
    ord(A) < ord(B).
.output conflict

.decl in_conflict(z: symbol)
in_conflict(Z) :- conflict(Z, _, _).
in_conflict(Z) :- conflict(_, Z, _).

// Certainly chargeable: survived every hard rule and competes with nothing.
.decl billable(z: symbol)
billable(Z) :- surviving_age(Z), !in_conflict(Z).
.output billable

// Chargeable in principle, but a choice is required.
.decl needs_arbitration(z: symbol)
needs_arbitration(Z) :- surviving_age(Z), in_conflict(Z).
.output needs_arbitration

.decl chargeable(z: symbol)
chargeable(Z) :- billable(Z).
chargeable(Z) :- needs_arbitration(Z).

// ============================================================================================
// LAYER 5 — Steigerungsfaktor validation (§ 5, § 12 Abs. 3 GOÄ)
// ============================================================================================
// Values are scaled by 100 because Datalog numbers are integers: 230 means factor 2.3.

.decl factor_band(z: symbol, threshold: number, max_factor: number)
factor_band(Z, T, M) :- chargeable(Z), sf_override(Z, T, M).
factor_band(Z, T, M) :- chargeable(Z), ziffer(Z, _, K, _), sf_band(K, T, M), !sf_override(Z, _, _).
.output factor_band

// Above the Schwellenwert a written justification is mandatory.
.decl needs_justification(z: symbol, factor: number, threshold: number)
needs_justification(Z, F, T) :-
    chargeable(Z), factor_band(Z, T, _), proposed_factor(Z, F), F > T.
.output needs_justification

// Above the Höchstsatz the factor is unlawful absent a § 2 agreement.
.decl invalid_factor(z: symbol, factor: number, max_factor: number)
invalid_factor(Z, F, M) :-
    chargeable(Z), factor_band(Z, _, M), proposed_factor(Z, F), F > M.
.output invalid_factor

// A per-Ziffer cap from the Leistungslegende overrides the band.
.decl invalid_factor_cap(z: symbol, factor: number, cap: number, rule_id: symbol)
invalid_factor_cap(Z, F, Cap, RuleId) :-
    chargeable(Z), factor_cap(RuleId, Z, Cap), proposed_factor(Z, F), F > Cap.
.output invalid_factor_cap

// ============================================================================================
// LAYER 6 — § 6a GOÄ Minderung
// ============================================================================================

.decl mindered(z: symbol, rate: number)
mindered(Z, R) :-
    chargeable(Z), patient_setting(S), minderung_rate(S, R), R > 0, !minderung_exempt(Z).
.output mindered

// ============================================================================================
// PROOF TREE
// ============================================================================================
// Every conclusion, positive and negative, gets a justification row carrying the rule id that
// produced it. This is the machine-checkable answer to "why is this on my bill?".

.decl proof(z: symbol, rule: symbol, detail: symbol, rule_id: symbol)
.output proof

proof(Z, "catalog_match", "present_and_active_in_loaded_catalog", "") :-
    chargeable(Z).

proof(Z, "derived_from_act", T, "") :-
    chargeable(Z), candidate(A, Z, _, _), act(A, _, T).

proof(Z, "most_specific_candidate", "no_more_specific_position_for_the_same_act", "") :-
    chargeable(Z), !blocked_less_specific(Z, _, _).

proof(Z, "not_zielleistung_component", "not_a_component_of_another_charged_service", "") :-
    chargeable(Z), !blocked_zielleistung(Z, _, _).

proof(Z, "not_excluded", "no_one_way_exclusion_violated", "") :-
    chargeable(Z), !blocked_exclusion(Z, _, _), !blocked_exclusion_cross_date(Z, _, _).

proof(Z, "no_unresolved_conflict", "no_mutually_exclusive_competitor", "") :-
    billable(Z), !in_conflict(Z).

proof(Z, "blocked_less_specific", W, RuleId) :- blocked_less_specific(Z, W, RuleId).
proof(Z, "blocked_zielleistung", P, RuleId) :- blocked_zielleistung(Z, P, RuleId).
proof(Z, "blocked_exclusion", A, RuleId) :- blocked_exclusion(Z, A, RuleId).
proof(Z, "blocked_exclusion_cross_date", A, RuleId) :- blocked_exclusion_cross_date(Z, A, RuleId).

// Deliberately negative-only, unlike the positive `not_excluded`-style lines above. Those cover
// checks every golden case was already captured against; these four are new, and an unconditional
// positive line here (`chargeable(Z), !blocked_quantity(Z, _, _, _)`) would add a proof row to
// EVERY chargeable position in EVERY existing case — not just the ones a new rule ever touches —
// which reorders `tests/golden/*/expected.json`'s frozen proof-step arrays for a check that never
// actually ran. A negative row appears only when something was actually concluded.
proof(Z, "blocked_quantity", "history_count_at_or_above_max", RuleId) :-
    blocked_quantity(Z, RuleId, _, _).
proof(Z, "blocked_time_relation", A, RuleId) :- blocked_time_relation(Z, A, RuleId).
proof(Z, "blocked_gender", Allowed, RuleId) :- blocked_gender(Z, RuleId, _, Allowed).
proof(Z, "blocked_age", "outside_permitted_age_band", RuleId) :- blocked_age(Z, RuleId, _, _, _).
proof(Z, "time_relation_advisory", B, RuleId) :- time_relation_advisory(Z, B, RuleId).

proof(Z, "conflict_pending_arbitration", B, RuleId) :- conflict(Z, B, RuleId).
proof(Z, "conflict_pending_arbitration", A, RuleId) :- conflict(A, Z, RuleId).

proof(Z, "unknown_ziffer", "not_present_in_loaded_catalog", "") :- unknown_ziffer(Z).
proof(Z, "inactive_ziffer", "present_but_not_active_in_catalog", "") :- inactive_ziffer(Z).

proof(Z, "justification_required", "factor_above_schwellenwert_needs_written_reason", "") :-
    needs_justification(Z, _, _).
proof(Z, "factor_above_hoechstsatz", "unlawful_without_agreement_under_para_2_goae", "") :-
    invalid_factor(Z, _, _).
proof(Z, "factor_above_cap", "leistungslegende_caps_this_position", RuleId) :-
    invalid_factor_cap(Z, _, _, RuleId).

proof(Z, "minderung_applicable", S, "") :-
    chargeable(Z), patient_setting(S), minderung_rate(S, R), R > 0, !minderung_exempt(Z).
proof(Z, "minderung_exempt", "para_6a_abs_1_satz_3_goae", "") :-
    chargeable(Z), minderung_exempt(Z).
